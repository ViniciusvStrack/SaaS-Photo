# ===== Banco de dados =====
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ===== Autenticação =====
JWT_SECRET=noirframe-dev-secret-change-in-production-2025

# ===== Cron (protege as rotas /api/cron/*) =====
CRON_SECRET=noirframe-cron-dev

# ===== URL pública da aplicação (usada nos links de email) =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Emails (Resend) =====
# 1. Crie sua conta em https://resend.com
# 2. Em "API Keys", gere uma chave e cole aqui (ex: re_...)
RESEND_API_KEY=
# Remetente: use um domínio verificado no Resend (ex: contato@noirframe.com).
# Sem domínio verificado, use: NoirFrame <onboarding@resend.dev>
# (o Resend só entrega emails desse remetente para o email da sua conta).
EMAIL_FROM=NoirFrame <onboarding@resend.dev>
